---
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import CarteArticle from '../../../components/CarteArticle.astro';
import Etat from '../../../components/Etat.astro';
import { t as traduire } from '../../../i18n/ui';
import { APERCU, LANGS, getArticles, html, lien, minutesDeLecture, sommaire, type Lang } from '../../../lib/content';
import { jourLong } from '../../../lib/dates';

export async function getStaticPaths() {
  const articles = await getArticles();
  return LANGS.flatMap((lang) =>
    articles.map((article) => ({
      // La pagination de la liste occupe /articles/2/, /articles/3/… : un identifiant purement numérique est écarté.
      params: { lang, id: article.id },
      props: {
        article,
        voisins: articles.filter((a) => a.id !== article.id && a.themes.some((x) => article.themes.includes(x))).slice(0, 3),
      },
    })).filter((p) => !/^\d+$/.test(p.params.id)),
  );
}
const lang = Astro.params.lang as Lang;
const { article: a, voisins } = Astro.props;
const t = traduire(lang);
const d = a.data[lang] ?? {};
const img = a.data.image;
const corps = await html(d.corps);
const sources = await html(a.data.sources);
const plan = sommaire(corps);
const partage = a.couverture ? (await getImage({ src: a.couverture, width: 1200, height: 630, format: 'png' })).src : undefined;
---

<Base lang={lang} titre={d.titre ?? ''} description={d.chapo ?? undefined} image={partage} type="article">
  <div class="progression" data-progression aria-hidden="true"></div>
  <article class="article">
    <header class="conteneur article-tete">
      <p class="surtitre">
        {a.themes.map((th, i) => <>{i > 0 && <span aria-hidden="true">/</span>}<a href={lien(lang, `thematiques/${th.id}`)}>{th.data[lang]?.nom}</a></>)}
        {a.zone && <span class="pastille">{a.zone[lang]}</span>}
        <Etat etat={a.etat} />
      </p>
      <h1>{d.titre || '(sans titre)'}</h1>
      <p class="chapo">{d.chapo}</p>
      <div class="signature">
        <span>
          {t('article.par')}{' '}
          {a.auteurs.map((x, i) => <>{i > 0 && ', '}<strong>{x.nom}</strong>{x.promotion && ` (${x.promotion})`}</>)}
        </span>
        <span class="mono">
          {a.date && <time datetime={a.date.toISOString()}>{jourLong(a.date, lang)}</time>}
          {' · '}{minutesDeLecture(d.corps)} {t('article.lecture')}
        </span>
        <span class="partage">
          <button class="bouton-icone" type="button" data-copier={t('article.copie')} aria-label={t('article.copier')}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path></svg>
          </button>
          <a class="bouton-icone" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href)}`} rel="noopener" target="_blank" aria-label={t('article.linkedin')}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.9 8.6H3.6V20h3.3V8.6ZM5.3 3.5a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM20.4 13.5c0-3.3-1.8-5.1-4.300-5.1a3.900 3.900 0 0 0-3.400 1.800V8.600H9.400V20h3.300v-6c0-1.600.8-2.600 2.200-2.600 1.300 0 2.100.9 2.100 2.600v6h3.300l.1-6.500Z"></path></svg>
          </a>
        </span>
      </div>
      {
        APERCU && a.etat.blocages.length > 0 && (
          <div class="blocages">
            <strong>Non publiable en l'état :</strong>
            <ul>{a.etat.blocages.map((b) => <li>{b}</li>)}</ul>
          </div>
        )
      }
    </header>
    {
      a.couverture && (
        <figure class="conteneur article-couverture">
          <Image src={a.couverture} alt={(lang === 'fr' ? img?.alt_fr : img?.alt_en) ?? ''} width={1600} height={686} loading="eager" transition:name={`couv-${a.id}`} />
          <figcaption>
            {t('article.credit')} : {img?.source ? <a href={img.source} rel="noopener">{img?.credit}</a> : img?.credit}
            {img?.licence && ` · ${img.licence}`}
          </figcaption>
        </figure>
      )
    }
    <div class:list={['conteneur', 'article-corps', { 'sans-sommaire': plan.length < 2 }]}>
      {
        plan.length >= 2 && (
          <nav class="sommaire" data-sommaire aria-label={t('article.sommaire')}>
            <p class="mono">{t('article.sommaire')}</p>
            {plan.map((p) => <a href={`#${p.id}`}>{p.titre}</a>)}
          </nav>
        )
      }
      <div data-lecture>
        <div class="prose lettrine" set:html={corps} />
        {
          sources && (
            <section class="sources">
              <h2>{t('article.sources')}</h2>
              <div class="prose petit" set:html={sources} />
            </section>
          )
        }
        <p class="avertissement">{t('article.avertissement')}</p>
      </div>
    </div>
  </article>
  {
    voisins.length > 0 && (
      <section class="conteneur bloc">
        <h2 class="titre-section seul">{t('article.memeTheme')}</h2>
        <div class="grille-articles">{voisins.map((v, i) => <CarteArticle article={v} lang={lang} i={i} />)}</div>
      </section>
    )
  }
</Base>
